# =============================================================================
# The Lenny Growth Assistant - environment configuration
# Copy to .env and fill in. `cp .env.example .env` is enough to boot the
# local-only demo: every REQUIRED value below already has a working default.
# =============================================================================

# ---------- Core ----------
# REQUIRED. Postgres connection. The docker-compose default points at the
# bundled `db` service; override to use Supabase/Railway/any managed Postgres.
DATABASE_URL=postgresql+asyncpg://lenny:lenny@db:5432/lenny

# OPTIONAL. debug | info | warning | error
LOG_LEVEL=info
# OPTIONAL. json is machine-parseable (use in deployment); console is readable.
LOG_FORMAT=json
# OPTIONAL. Comma-separated allowed CORS origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# ---------- Model selection ----------
# REQUIRED. The active provider. Switch this alone to change models -
# no code change. One of: ollama | groq | openai | anthropic
# `ollama` is the default so a fresh clone runs with zero API keys.
LLM_PROVIDER=ollama

# OPTIONAL. Ordered comma-separated fallback chain, tried left to right when
# the active provider fails (down, timeout, missing key, rate limited).
# Leave empty to disable fallback and surface the error directly.
LLM_FALLBACK_CHAIN=ollama

# OPTIONAL. Per-request ceiling in seconds before a provider is considered
# failed and the fallback chain advances.
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.3

# ---------- Provider: Ollama (local, mandatory for the demo) ----------
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Any tool-calling capable local model. llama3.1/3.2 recommended.
OLLAMA_MODEL=llama3.2

# ---------- Provider: Groq (cloud, OpenAI-compatible) ----------
# OPTIONAL unless LLM_PROVIDER=groq.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ---------- Provider: OpenAI (cloud) ----------
# OPTIONAL unless LLM_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ---------- Provider: Anthropic via Claude Agent SDK (cloud) ----------
# OPTIONAL unless LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---------- Retrieval ----------
# OPTIONAL. Dense embeddings are served by Ollama. If the model is not
# pulled or Ollama is unreachable, retrieval degrades to lexical-only BM25
# instead of failing. Set EMBEDDINGS_ENABLED=false to skip it entirely.
EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
RETRIEVAL_TOP_K=8
# Share of a question's meaning (IDF-weighted) that must actually appear in a
# passage for it to count as evidence. Raise it for stricter grounding and more
# "I can't answer that"; lower it for more coverage and more risk. 0.30 is
# tuned in tests/test_retrieval.py against known in- and out-of-corpus queries.
RETRIEVAL_MIN_COVERAGE=0.45

# ---------- Corpus ----------
# Source of truth for transcripts. Cloned by `scripts/ingest.py`.
# Content is licensed and is NOT redistributed in this repo.
CORPUS_REPO_URL=https://github.com/LennysNewsletter/lennys-newsletterpodcastdata.git
CORPUS_DIR=./data/corpus
